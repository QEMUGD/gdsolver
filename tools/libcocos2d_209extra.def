; Exports of the 2.209 libcocos2d.dll that the SDK's libcocos2d.lib (made for 2.2081) does not list: functions 2.209 added to cocos2d classes (CCApplication,
; CCDirector, CCEGLView, the dispatchers, ...), changed signatures, and the two classes the 2.209 bindings name as bases (CCTouchClipper,
; CCKeyboardActionManager). CMakeLists.txt turns this file into an import library for 2.209 builds, so the mod can link what the game headers declare.
LIBRARY libcocos2d.dll
EXPORTS
    ??0CCKeyboardActionManager@cocos2d@@QEAA@$$QEAV01@@Z
    ??0CCKeyboardActionManager@cocos2d@@QEAA@AEBV01@@Z
    ??0CCKeyboardActionManager@cocos2d@@QEAA@XZ
    ??0CCTouchClipper@cocos2d@@QEAA@AEBV01@@Z
